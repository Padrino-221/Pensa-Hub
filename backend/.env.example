# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/puhub

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Cookie: secure=true + samesite=none only when the frontend is served over
# HTTPS and possibly on a different origin than the API (e.g. Vercel + Render).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Cloudinary (optional — without it, uploads fall back to local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
